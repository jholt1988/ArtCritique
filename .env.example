# APP_URL — this variable is no longer read by any code in this repo (the
# single-origin architecture resolves /api relative to the page, so there is
# no runtime self-referencing that required it). If you need to expose the
# public URL (e.g. for OAuth callbacks or absolute redirect links), add its
# code here; until then it's dead config.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Can be overridden per-request via the ProviderSettings panel
# (x-custom-api-key header) — see server.ts / ProviderSettingsModal.tsx.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_PROXY_API_TARGET: used only when running `vite preview` (a separate
# Vite dev server) against the Express API server. Defaults to
# http://localhost:3000. See vite.config.ts.
# VITE_PROXY_API_TARGET="http://localhost:3000"
